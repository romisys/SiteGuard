GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=2048
# 0 disables thinking; higher = slower/more expensive
DATA_DIR=./data

# Serverless (Vercel) — leave unset for local dev
# Postgres connection string; unset falls back to SQLite under DATA_DIR
DATABASE_URL=
# Vercel Blob token; unset falls back to local file storage under DATA_DIR
BLOB_READ_WRITE_TOKEN=
# 1 runs the analysis inside the request instead of a background task
SITEGUARD_SYNC_ANALYSIS=
